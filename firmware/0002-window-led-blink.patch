-void UdsSystem::execute() {}
+void UdsSystem::execute()
+{
+#ifdef PLATFORM_SUPPORT_IO
+    // ~2Hz blink (25 * 10ms half-period) of EVAL_LED_RED while the Guardian
+    // Loop's WindowPosition target is open (>0%). Visible, physical proof
+    // that the UDS WriteDataByIdentifier actually landed on this ECU, not
+    // just a RAM-buffer echo back over ReadDataByIdentifier.
+    static uint32_t counter = 0U;
+    ++counter;
+
+    if (storedWindowPosition[0] > 0U)
+    {
+        if ((counter % 25U) == 0U)
+        {
+            _windowLedState = !_windowLedState;
+            Output::set(Output::EVAL_LED_RED, _windowLedState ? 1 : 0);
+        }
+    }
+    else if (_windowLedState)
+    {
+        _windowLedState = false;
+        Output::set(Output::EVAL_LED_RED, 0);
+    }
+#endif
+}

 } // namespace uds
