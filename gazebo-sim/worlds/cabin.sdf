<!--
  Guardian Loop cabin world for Gazebo Fortress (ign-gazebo 6): an open-top
  car (convertible, no roof) in a parent-and-child bay of a parking lot.

  Primitives only: no meshes, no Fuel downloads. Contents:
    ground_plane    asphalt
    parking_lot     static: bay markings, curb, trees, lamp (visual only)
    parked_car_1/2  static neighbours in the bays to the right (visual only)
    cabin           our car, welded to the world
      body               floor, doors (belt line z 0.875), hood, trunk,
                         windshield, fixed side windows, front seats, wheels
      seat_row2          rear seat; contact sensor on the cushion
      window_row2_left   rear-left glass on a prismatic joint (axis down =
                         open); slides into the rear-left door
    child_seat      a toddler in a child seat (visual) on a free rigid body;
                    starts on the ground next to the car, moved with
                    gazebo-sim/child-seat.sh

  The functional geometry (floor top z 0.375, seat cushion top z 0.625 at
  x -0.6, window opening x -0.95..-0.05 / z 0.875..1.275, joint and topic
  names) is the same as before; only the look changed.

  @WINDOW_TRAVEL_M@ is replaced by the launch file with travel_m from
  config/window.yaml. Run the world through the launch file, not directly.

  Gazebo-side topics are set explicitly (Fortress defaults would add a joint
  index or a /world/<name>/ prefix) and must match config/bridge.yaml.

  No Sensors system on purpose: it needs a rendering engine, and the headless
  container has no GPU. The Contact system covers the seat sensor.
-->
<sdf version="1.8">
  <world name="cabin">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <!-- create / remove / set_pose services, used by child-seat.sh -->
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <!-- state for the optional GUI client -->
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- publishes contact sensors; physics based, no rendering needed -->
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.62 0.76 0.9 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.16 0.16 0.17 1</ambient><diffuse>0.22 0.22 0.23 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="parking_lot">
      <static>true</static>
      <link name="link">
        <visual name="bay_line_0">
          <pose>0 -8.5 0.004 0 0 0</pose>
